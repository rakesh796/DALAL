<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Vibration -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Launcher: list all installed apps -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- Notification -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- System alert window for bubbles (future) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Background services. Android 14+ needs the typed permission or the service crashes -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DALAL">

        <!-- Main Launcher Activity -->
        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.DALAL">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Custom Input Method (Keyboard) -->
        <service
            android:name=".ime.ScalperKeyboardService"
            android:exported="true"
            android:label="@string/keyboard_label"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- Live Data Service (connects to Termux helper) -->
        <service
            android:name=".service.LiveDataService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Loss Limit Enforcer Service -->
        <service
            android:name=".service.LossLimitEnforcerService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
            Not built yet (see docs/IMPLEMENTATION_STATUS.md), add back when the classes exist:
            DashboardActivity, OrderFormActivity, JournalActivity, SettingsActivity,
            KiteLoginActivity, bubble.PriceBubbleService, receiver.BootReceiver, FileProvider
        -->

    </application>

</manifest>
